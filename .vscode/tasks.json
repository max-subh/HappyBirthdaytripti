{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install project dependencies",
      "type": "shell",
      "command": "bun",
      "args": ["install", "--frozen-lockfile"],
      "problemMatcher": []
    },
    {
      "label": "Start dev server",
      "type": "shell",
      "command": "bun",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Type-check project",
      "type": "shell",
      "command": "bun",
      "args": ["run", "lint"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build project",
      "type": "shell",
      "command": "bun",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
